#!/usr/bin/env python3
"""Check GitHub CI for the commits this session pushed.

Modes:
  pr-ci-gate --state FILE          check the SHAs recorded in FILE
  pr-ci-gate [--repo DIR] [--stack [N] | BRANCH...]   check branches ad hoc
  pr-ci-gate record ...            internal: record a push (used by the hooks)

Exit codes: 0 every commit passes, 1 a check fails, 2 CI is pending or unreadable.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

PASS = 0
FAIL = 1
PENDING = 2
USAGE = 64

PASS_CONCLUSIONS = {"success", "skipped", "neutral", "stale"}
FAIL_CONCLUSIONS = {"failure", "cancelled", "timed_out", "action_required", "startup_failure"}
FAIL_STATES = {"failure", "error"}
PENDING_STATES = {"queued", "in_progress", "pending", "requested", "waiting"}
NO_CHECKS_GRACE = 600


class Parser(argparse.ArgumentParser):
    """argparse exits 2 on bad usage, but 2 means CI pending here."""

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(USAGE, f"{self.prog}: error: {message}\n")


def state_dir() -> Path:
    return Path(os.environ.get("TASK_GH_GUARD_STATE_DIR", "~/.agents/state/task-gh-guard")).expanduser()


def safe_session_id(raw) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "_", raw if isinstance(raw, str) else "") or "unknown"


def state_path(runtime: str, session_id: str) -> Path:
    return state_dir() / f"{runtime}-{safe_session_id(session_id)}.json"


def write_state(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def read_state(path: Path, runtime: str, session_id: str) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(data, dict) and isinstance(data.get("entries"), list):
            return data
    except (OSError, ValueError):
        pass
    return {"version": 1, "runtime": runtime, "session_id": session_id, "entries": []}


def run(cmd, cwd=None, timeout=60):
    try:
        proc = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, proc.stdout, proc.stderr
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", str(exc)


def git(repo, *args, timeout=20):
    code, out, _ = run(["git", "-C", str(repo), *args], timeout=timeout)
    return out.strip() if code == 0 else None


def toplevel(path) -> Path | None:
    top = git(path, "rev-parse", "--show-toplevel")
    return Path(top) if top else None


def git_dir(repo) -> Path:
    raw = git(repo, "rev-parse", "--path-format=absolute", "--git-dir")
    return Path(raw) if raw else Path(repo) / ".git"


def current_branch(repo):
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    return branch if branch and branch != "HEAD" else None


def origin_slug(repo):
    # `remote get-url` expands insteadOf rewrites; the configured URL is the one that names GitHub.
    url = git(repo, "config", "--get", "remote.origin.url") or git(repo, "remote", "get-url", "origin")
    if not url:
        return None
    match = re.search(r"github\.com[:/]+([^/]+)/([^/]+?)(?:\.git)?/?$", url)
    return (match.group(1), match.group(2)) if match else None


def same_as_origin(repo, branch):
    local = git(repo, "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}")
    remote = git(repo, "rev-parse", "--verify", f"refs/remotes/origin/{branch}^{{commit}}")
    return local if local and remote and local == remote else None


def open_stack_branches(repo, number=None):
    """Open branches of the gh stack holding the current branch (or stack `number`)."""
    try:
        data = json.loads((git_dir(repo) / "gh-stack").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    cur = current_branch(repo)
    for stack in data.get("stacks", []):
        if number is not None and str(stack.get("number")) != str(number):
            continue
        if number is None and not any(b.get("branch") == cur for b in stack.get("branches", [])):
            continue
        branches = [
            b["branch"]
            for b in stack.get("branches", [])
            if b.get("branch") and not (b.get("pullRequest") or {}).get("merged")
        ]
        if branches:
            return branches
    return []


def split_segments(command):
    return [s.strip() for s in re.split(r"(?:&&|\|\||;|\n)+", command) if s.strip()]


def classify(tokens):
    for token in tokens:
        if os.path.basename(token) == "git-sign-batch":
            return {"kind": "sign", "dry": any(t in {"--dry-run", "--no-push"} for t in tokens)}
    for i, token in enumerate(tokens):
        name = os.path.basename(token)
        if name == "git":
            j = i + 1
            repo = None
            while j < len(tokens):
                if tokens[j] == "-C" and j + 1 < len(tokens):
                    repo = tokens[j + 1]
                    j += 2
                    continue
                if tokens[j].startswith("-"):
                    j += 1
                    continue
                break
            if j < len(tokens) and tokens[j] == "push":
                return {"kind": "push", "repo": repo, "args": tokens[j + 1:]}
        if (
            name == "gh"
            and i + 2 < len(tokens)
            and tokens[i + 1] == "stack"
            and tokens[i + 2] in {"push", "submit", "link"}
        ):
            return {"kind": "stack"}
    return None


def push_hits(command):
    hits = []
    for segment in split_segments(command):
        try:
            tokens = shlex.split(segment)
        except ValueError:
            tokens = segment.split()
        hit = classify(tokens)
        if hit:
            hits.append((segment, hit))
    return hits


def is_push_command(command):
    return bool(push_hits(command))


def push_branches(repo, args):
    """Branches named by a `git push` command line."""
    remotes = set((git(repo, "remote") or "").split())
    branches = []
    seen_remote = False
    for token in args:
        if token.startswith("-"):
            continue
        if not seen_remote and token in remotes:
            seen_remote = True
            continue
        source, _, target = token.partition(":")
        branch = target or source
        if branch.startswith("refs/heads/"):
            branch = branch[len("refs/heads/"):]
        if branch == "HEAD":
            branch = current_branch(repo)
        if branch and branch not in branches:
            branches.append(branch)
    return branches


def record(runtime, session_id, cwd, command):
    """Record the branches a push-like command landed, state only when local == origin."""
    cwd = Path(cwd).expanduser()
    hits = push_hits(command)
    if not hits:
        return {"recorded": [], "skipped": [], "reason": "not a push"}
    pairs = []
    skipped = []
    for _segment, hit in hits:
        if hit["kind"] == "sign":
            if hit["dry"]:
                skipped.append({"reason": "dry run"})
                continue
            repo = toplevel(cwd)
            if repo and current_branch(repo):
                pairs.append((repo, current_branch(repo)))
            continue
        if hit["kind"] == "stack":
            repo = toplevel(cwd)
            if not repo:
                skipped.append({"reason": f"not a git repo: {cwd}"})
                continue
            branches = open_stack_branches(repo) or [current_branch(repo)]
            pairs.extend((repo, branch) for branch in branches if branch)
            continue
        path = cwd / hit["repo"] if hit.get("repo") else cwd
        repo = toplevel(path)
        if not repo:
            skipped.append({"reason": f"not a git repo: {path}"})
            continue
        branches = push_branches(repo, hit["args"]) or [current_branch(repo)]
        pairs.extend((repo, branch) for branch in branches if branch)

    recorded = []
    seen = set()
    for repo, branch in pairs:
        key = (str(repo), branch)
        if key in seen:
            continue
        seen.add(key)
        slug = origin_slug(repo)
        if not slug:
            skipped.append({"repo": str(repo), "branch": branch, "reason": "no GitHub origin"})
            continue
        sha = same_as_origin(repo, branch)
        if not sha:
            skipped.append({"repo": str(repo), "branch": branch, "reason": "local branch is not equal to origin"})
            continue
        recorded.append({"repo": str(repo), "owner": slug[0], "name": slug[1], "branch": branch, "sha": sha, "pushed_at": int(time.time())})

    if recorded:
        path = state_path(runtime, session_id)
        data = read_state(path, runtime, session_id)
        keys = {(item["repo"], item["branch"]) for item in recorded}
        data["entries"] = [e for e in data["entries"] if (e.get("repo"), e.get("branch")) not in keys] + recorded
        data["runtime"] = runtime
        data["session_id"] = session_id
        data["updated_at"] = int(time.time())
        write_state(path, data)
    return {"recorded": recorded, "skipped": skipped}


def gh_json(args, timeout=60):
    code, out, err = run(["gh", *args], timeout=timeout)
    if code != 0:
        return None, (err or out or f"gh exited {code}").strip()[:300]
    try:
        return json.loads(out or "null"), None
    except ValueError as exc:
        return None, f"bad JSON from gh: {exc}"


def fetch_check_runs(owner, name, sha):
    doc, error = gh_json(
        ["api", f"repos/{owner}/{name}/commits/{sha}/check-runs", "--paginate", "--slurp"]
    )
    if error:
        return None, error
    pages = doc if isinstance(doc, list) else [doc]
    runs = []
    for page in pages:
        if isinstance(page, dict):
            runs.extend(page.get("check_runs") or [])
    return runs, None


def fetch_statuses(owner, name, sha):
    doc, error = gh_json(["api", f"repos/{owner}/{name}/commits/{sha}/status"])
    if error:
        return None, error
    statuses = doc.get("statuses") if isinstance(doc, dict) else None
    return statuses or [], None


def pr_number(owner, name, sha):
    doc, error = gh_json(
        ["pr", "list", "--repo", f"{owner}/{name}", "--search", sha, "--state", "all", "--json", "number", "--limit", "1"],
        timeout=30,
    )
    if error or not isinstance(doc, list) or not doc:
        return None
    return doc[0].get("number")


def drop_superseded(runs):
    """Drop a cancelled run when a later run of the same check finished on the same commit."""
    def started(run):
        return run.get("started_at") or ""

    keep = []
    for run in runs:
        if (run.get("conclusion") or "").lower() == "cancelled" and any(
            other is not run
            and other.get("name") == run.get("name")
            and (other.get("status") or "").lower() == "completed"
            and (other.get("conclusion") or "").lower() != "cancelled"
            and started(other) >= started(run)
            for other in runs
        ):
            continue
        keep.append(run)
    return keep


def check_entry(entry, now, lookup_pr):
    owner = entry.get("owner")
    name = entry.get("name")
    sha = entry.get("sha")
    base = {
        "repo": entry.get("repo", ""),
        "owner": owner,
        "name": name,
        "branch": entry.get("branch", "?"),
        "sha": sha or "",
        "pushed_at": entry.get("pushed_at"),
        "status": "pass",
        "checks": [],
        "error": None,
    }
    if not (owner and name and sha):
        base.update(status="pending", error="incomplete state entry (owner, repo or sha missing)")
        return base

    runs, runs_error = fetch_check_runs(owner, name, sha)
    statuses, status_error = fetch_statuses(owner, name, sha)
    error = runs_error or status_error
    if error:
        if "No commit found for SHA" in error:
            error = f"{sha[:7]} is not on GitHub (unpushed commit, or it belongs to another repo)"
        base.update(
            status="pending",
            error=error,
            checks=[{"name": "ci", "state": "unknown", "url": "", "pr": None, "kind": "error", "message": error}],
        )
        return base

    runs = drop_superseded(runs)
    fails, pending = [], []
    for item in runs:
        conclusion = (item.get("conclusion") or "").lower()
        state = (item.get("status") or "").lower()
        check = {
            "name": item.get("name") or "check",
            "state": conclusion or state or "pending",
            "url": item.get("details_url") or item.get("html_url") or "",
            "pr": None,
            "kind": "check_run",
        }
        if conclusion in FAIL_CONCLUSIONS:
            fails.append(check)
        elif conclusion in PASS_CONCLUSIONS:
            continue
        else:
            pending.append(check)

    for item in statuses:
        state = (item.get("state") or "").lower()
        check = {
            "name": item.get("context") or "status",
            "state": state or "pending",
            "url": item.get("target_url") or "",
            "pr": None,
            "kind": "status",
        }
        if state in FAIL_STATES:
            fails.append(check)
        elif state == "success":
            continue
        else:
            pending.append(check)

    if fails:
        pr = pr_number(owner, name, sha) if lookup_pr else None
        for check in fails:
            check["pr"] = pr
        base.update(status="fail", checks=fails)
    elif pending:
        base.update(status="pending", checks=pending)
    elif not runs and not statuses:
        pushed_at = entry.get("pushed_at") or now
        age = max(0, now - int(pushed_at))
        if age < NO_CHECKS_GRACE:
            base.update(
                status="pending",
                checks=[{
                    "name": "no check runs",
                    "state": "pending",
                    "url": "",
                    "pr": None,
                    "kind": "wait",
                    "message": f"none reported yet ({age}s after push)",
                }],
            )
    return base


def build_message(status, entries):
    if status == "pass":
        return ""
    blocks = []
    for entry in entries:
        if entry["status"] == "pass":
            continue
        label = f"{entry['branch']}@{entry['sha'][:7]}"
        if entry["status"] == "fail":
            lines = [f"CI failed on {label}:"]
        else:
            if entry.get("error") and not entry["checks"]:
                lines = [f"CI unavailable on {label}: {entry['error']}"]
                blocks.append("\n".join(lines))
                continue
            summary = ", ".join(f"{c['name']} ({c['state']})" for c in entry["checks"])
            lines = [f"CI pending on {label}: {summary}."]
        for check in entry["checks"]:
            text = f"- {check['name']} ({check['state']})"
            if check.get("url"):
                text += f" {check['url']}"
            if check.get("pr"):
                text += f" PR #{check['pr']}"
            if check.get("message") and not check.get("url"):
                text += f": {check['message']}"
            lines.append(text)
        blocks.append("\n".join(lines))
    return "\n".join(blocks)


def evaluate(entries, now=None, lookup_pr=True):
    now = int(time.time()) if now is None else now
    results = [check_entry(entry, now, lookup_pr) for entry in entries]
    if any(entry["status"] == "fail" for entry in results):
        status = "fail"
    elif any(entry["status"] == "pending" for entry in results):
        status = "pending"
    else:
        status = "pass"
    return {"status": status, "message": build_message(status, results), "entries": results}


def adhoc_entries(repo_path, branches, stack_requested, stack_number):
    repo = toplevel(repo_path)
    if not repo:
        raise SystemExit(f"pr-ci-gate: not a git repository: {repo_path}")
    slug = origin_slug(repo)
    if not slug:
        raise SystemExit(f"pr-ci-gate: no GitHub origin in {repo}")
    if stack_requested:
        found = open_stack_branches(repo, stack_number)
        if not found and not branches:
            label = f"stack {stack_number}" if stack_number is not None else "a stack"
            raise SystemExit(f"pr-ci-gate: no open {label} holding {current_branch(repo) or 'HEAD'}")
        branches = branches or found
    branches = branches or [current_branch(repo)]
    entries = []
    for branch in [b for b in branches if b]:
        sha = git(repo, "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}") or git(
            repo, "rev-parse", "--verify", f"refs/remotes/origin/{branch}^{{commit}}"
        )
        if not sha:
            entries.append({
                "repo": str(repo), "owner": slug[0], "name": slug[1], "branch": branch,
                "sha": "", "pushed_at": None, "status": "pending",
                "checks": [], "error": f"branch not found: {branch}",
            })
            continue
        stamp = git(repo, "show", "-s", "--format=%ct", sha)
        entries.append({
            "repo": str(repo),
            "owner": slug[0],
            "name": slug[1],
            "branch": branch,
            "sha": sha,
            "pushed_at": int(stamp) if stamp and stamp.isdigit() else int(time.time()),
            "status": "pass",
            "checks": [],
            "error": None,
        })
    return entries


def record_main(argv):
    parser = Parser(prog="pr-ci-gate record", description="Record a push-like command (internal).")
    parser.add_argument("--runtime", required=True, choices=["claude", "opencode"])
    parser.add_argument("--session", required=True)
    parser.add_argument("--cwd", default=os.getcwd())
    parser.add_argument("--command", required=True)
    args = parser.parse_args(argv)
    print(json.dumps(record(args.runtime, args.session, args.cwd, args.command), indent=2))
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "record":
        return record_main(argv[1:])

    parser = Parser(prog="pr-ci-gate", description="Check GitHub CI for the commits this session pushed.")
    parser.add_argument("--state", metavar="FILE", help="check the SHAs recorded in FILE")
    parser.add_argument("--repo", default=".", metavar="DIR", help="repository to check (default: cwd)")
    parser.add_argument("--stack", nargs="?", const="", metavar="N", help="branches of the current gh stack, or stack N")
    parser.add_argument("--wait", type=int, default=0, metavar="SECONDS", help="poll until CI is no longer pending")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("branches", nargs="*", help="branches to check")

    args = parser.parse_args(argv)

    if args.state and (args.branches or args.stack is not None):
        parser.error("--state cannot be combined with branches or --stack")
    if args.stack is not None and args.branches:
        parser.error("use --stack or branch names, not both")
    if args.stack and not args.stack.isdigit():
        parser.error("--stack takes a stack number, not a branch name")

    if args.state:
        path = Path(args.state).expanduser()
        if not path.is_file():
            result = {"status": "pass", "message": "", "entries": []}
        else:
            data = read_state(path, "unknown", "unknown")
            result = evaluate(data["entries"], lookup_pr=True)
    else:
        stack_requested = args.stack is not None
        stack_number = int(args.stack) if args.stack else None
        entries = adhoc_entries(args.repo, args.branches, stack_requested, stack_number)
        result = evaluate(entries, lookup_pr=True)

    deadline = time.monotonic() + max(0, args.wait)
    while result["status"] == "pending" and time.monotonic() < deadline:
        time.sleep(min(10, max(0.0, deadline - time.monotonic())))
        if args.state:
            path = Path(args.state).expanduser()
            if not path.is_file():
                result = {"status": "pass", "message": "", "entries": []}
                break
            result = evaluate(read_state(path, "unknown", "unknown")["entries"], lookup_pr=True)
        else:
            result = evaluate(
                adhoc_entries(args.repo, args.branches, stack_requested, stack_number), lookup_pr=True
            )

    if args.state and result["status"] == "pass":
        Path(args.state).expanduser().unlink(missing_ok=True)

    if args.json:
        print(json.dumps(result, indent=2))
    elif result["message"]:
        print(result["message"])
    elif result["status"] == "pass" and not args.state:
        print("CI passing: " + ", ".join(f"{e['branch']}@{e['sha'][:7]}" for e in result["entries"] if e["sha"]))

    return {"pass": PASS, "fail": FAIL, "pending": PENDING}[result["status"]]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
