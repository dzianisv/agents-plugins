#!/usr/bin/env bun
// Stand-in for gh used by the gh-guard tests. Serves FAKE_GH_DIR/scenario.json.
import { appendFileSync, readFileSync } from "node:fs"
import { join } from "node:path"

type Commit = {
  check_runs?: unknown[]
  statuses?: unknown[]
  state?: string
  pr?: number
}

const args = process.argv.slice(2)
const log = process.env.FAKE_GH_LOG
if (log) appendFileSync(log, `${JSON.stringify(args)}\n`)

const scenario = JSON.parse(readFileSync(join(process.env.FAKE_GH_DIR ?? "", "scenario.json"), "utf8")) as {
  repo?: string
  commits?: Record<string, Commit>
  branches?: Record<string, string>
  compare?: Record<string, string>
}
const commits = scenario.commits ?? {}

const emit = (value: unknown): never => {
  console.log(JSON.stringify(value))
  process.exit(0)
}

const die = (message: string): never => {
  process.stderr.write(`gh: ${message}\n`)
  process.exit(1)
}

// Simulates an expired exported token: any call that still carries GH_TOKEN is rejected.
if (process.env.FAKE_GH_BAD_TOKEN && process.env.GH_TOKEN) die("Bad credentials (HTTP 401)")

if (args[0] === "api") {
  const path = args.slice(1).find((arg) => !arg.startsWith("-")) ?? ""
  const parts = path.split("/")
  if (parts[3] === "branches") {
    const head = scenario.branches?.[parts.slice(4).join("/")]
    if (!head) die("Branch not found (HTTP 404)")
    emit({ commit: { sha: head } })
  }
  if (parts[3] === "compare") {
    const status = scenario.compare?.[parts[4] ?? ""]
    if (!status) die("Not Found (HTTP 404)")
    emit({ status })
  }
  const sha = parts[4] ?? ""
  const data = commits[sha]
  if (!data) die(`No commit found for SHA: ${sha} (HTTP 422)`)
  if (path.endsWith("/check-runs")) {
    const page = { total_count: (data.check_runs ?? []).length, check_runs: data.check_runs ?? [] }
    emit(args.includes("--slurp") ? [page] : page)
  }
  if (path.endsWith("/status")) {
    const statuses = data.statuses ?? []
    emit({
      state: data.state ?? (statuses.length ? "success" : "pending"),
      total_count: statuses.length,
      statuses,
    })
  }
  die(`unhandled API path: ${path}`)
}

if (args[0] === "pr" && args[1] === "list") {
  const index = args.indexOf("--search")
  const sha = index === -1 ? "" : args[index + 1]
  const number = commits[sha]?.pr
  emit(number ? [{ number, url: `https://github.com/${scenario.repo ?? "acme/widgets"}/pull/${number}` }] : [])
}

die(`unhandled arguments: ${args.join(" ")}`)
