#!/usr/bin/env python3
"""Stand-in for gh used by the task-gh-guard tests. Serves FAKE_GH_DIR/scenario.json."""

import json
import os
import sys

args = sys.argv[1:]
log = os.environ.get("FAKE_GH_LOG")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(args) + "\n")

with open(os.path.join(os.environ["FAKE_GH_DIR"], "scenario.json"), encoding="utf-8") as fh:
    scenario = json.load(fh)
commits = scenario.get("commits", {})
repo = scenario.get("repo", "acme/widgets")


def emit(value):
    print(json.dumps(value))
    sys.exit(0)


def die(message):
    print(f"gh: {message}", file=sys.stderr)
    sys.exit(1)


if args[:1] == ["api"]:
    path = next((a for a in args[1:] if not a.startswith("-")), "")
    parts = path.split("/")
    sha = parts[4] if len(parts) > 4 else ""
    data = commits.get(sha)
    if data is None:
        die(f"No commit found for SHA: {sha} (HTTP 422)")
    if path.endswith("/check-runs"):
        page = {"total_count": len(data.get("check_runs", [])), "check_runs": data.get("check_runs", [])}
        emit([page] if "--slurp" in args else page)
    if path.endswith("/status"):
        statuses = data.get("statuses", [])
        emit({"state": data.get("state", "pending" if not statuses else "success"), "total_count": len(statuses), "statuses": statuses})
    die(f"unhandled API path: {path}")

if args[:2] == ["pr", "list"]:
    sha = args[args.index("--search") + 1] if "--search" in args else ""
    number = commits.get(sha, {}).get("pr")
    emit([{"number": number, "url": f"https://github.com/{repo}/pull/{number}"}] if number else [])

die(f"unhandled arguments: {args}")
