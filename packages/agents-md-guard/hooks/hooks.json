{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin\" bun \"${CLAUDE_PLUGIN_ROOT}/src/claude/review.ts\"",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin\" bun \"${CLAUDE_PLUGIN_ROOT}/src/claude/stop.ts\"",
            "timeout": 150
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin\" bun \"${CLAUDE_PLUGIN_ROOT}/src/claude/prompt.ts\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin\" bun \"${CLAUDE_PLUGIN_ROOT}/src/claude/session-end.ts\""
          }
        ]
      }
    ]
  }
}
