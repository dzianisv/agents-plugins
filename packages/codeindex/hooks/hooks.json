{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin\" bun \"${CLAUDE_PLUGIN_ROOT}/src/claude/pretooluse.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
